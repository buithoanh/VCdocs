{
  "name": "@vcdocs/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:api": "openapi-typescript ../../contract/openapi.yaml -o src/api/schema.d.ts",
    "dev": "next dev -p 3000",
    "dev:mock": "API_ORIGIN=http://localhost:4010 API_PATH_PREFIX= NEXT_PUBLIC_MOCK=1 next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@tanstack/react-query": "^5.104.4",
    "antd": "6.6.7",
    "next": "15.5.28",
    "openapi-fetch": "0.14.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
