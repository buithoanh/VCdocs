# Máy chủ nghiệp vụ VCdocs – chép thành .env rồi sửa. KHÔNG ghi khoá thật vào file mẫu này.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vcdocs
PUBLIC_API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_DOMAIN=vcprosperous.com
# Cookie Secure: bật ở production (HTTPS); local http thì để false
COOKIE_SECURE=false
SESSION_HOURS=8

# Google: fake = bản giả trong bộ nhớ (local, test); real = googleapis + tài khoản máy
GOOGLE_MODE=fake
# Lưu trạng thái Google giả ra file (mặc định .vcdocs-dev/fake-google.json; "none" = chỉ trong bộ nhớ).
# Thiếu file mà CSDL đã có dữ liệu thì tự dựng lại danh bạ, drive, thư mục từ CSDL
FAKE_GOOGLE_STATE_FILE=.vcdocs-dev/fake-google.json
# Nạp dữ liệu mẫu khi CSDL trống (chỉ với GOOGLE_MODE=fake)
SEED_DEMO=true

# Chỉ dùng khi GOOGLE_MODE=real (để trống ở local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON tài khoản máy: chuỗi JSON, base64 của JSON, hoặc đường dẫn file (ngoài repo)
GOOGLE_SA_WRITE_KEY=
GOOGLE_SA_READ_KEY=
# Email quản trị Workspace để uỷ quyền toàn tên miền (Admin SDK)
GOOGLE_ADMIN_SUBJECT=
MAIL_FROM=vcdocs@vcprosperous.com

# Drive cơ bản VCworkspace: fake là mặc định an toàn. nextcloud chỉ dành cho
# local thử trên loopback; JSON ánh xạ email giả -> username/password giả riêng.
WORKSPACE_STORAGE_MODE=fake
WORKSPACE_STORAGE_BASE_URL=http://127.0.0.1:18080
WORKSPACE_STORAGE_CREDENTIALS_JSON={}
WORKSPACE_STORAGE_TIMEOUT_MS=15000

# Email local chat08. Mặc định fake; Stalwart chỉ dùng loopback và credential thử
# được nạp từ file tạm quyền 600, không ghi giá trị vào repo.
MAIL_ENGINE_MODE=fake
MAIL_ENGINE_HOST=127.0.0.1
MAIL_ENGINE_SMTP_PORT=18465
MAIL_ENGINE_IMAP_PORT=18993
MAIL_ENGINE_SIEVE_PORT=14190
MAIL_ENGINE_CONTROL_PORT=19090
MAIL_ENGINE_CONTROL_TOKEN=replace-with-a-dedicated-local-control-token
MAIL_ENGINE_CREDENTIALS_JSON={}
MAIL_ENGINE_MANAGEMENT_URL=
MAIL_ENGINE_MANAGEMENT_USER=
MAIL_ENGINE_MANAGEMENT_PASSWORD=

# ONLYOFFICE local (chat04). Dùng secret sinh riêng, không commit giá trị thật.
# Web chỉ nạp api.js từ origin trong NEXT_PUBLIC_DOCUMENT_SERVER_ORIGINS lúc build (bản build
# production không đặt thì tắt editor; ngoài production mặc định 127.0.0.1:18082). Giữ hai giá trị khớp nhau.
DOCUMENT_EDITOR_ENABLED=false
DOCUMENT_EDITOR_PUBLIC_ORIGIN=http://127.0.0.1:18082
DOCUMENT_EDITOR_INTERNAL_ORIGIN=http://127.0.0.1:18082
DOCUMENT_EDITOR_API_ORIGIN=http://host.docker.internal:4000
DOCUMENT_EDITOR_JWT_SECRET=change-me-local-only

# Kho riêng giữ PDF đã chốt (giai đoạn 1: thư mục trên máy chủ)
VAULT_DIR=.vault
UPLOAD_TMP_DIR=.uploads
# Font có dấu tiếng Việt để in dấu ĐÃ CHỐT (vd DejaVuSans.ttf); trống thì tự tìm
STAMP_FONT_PATH=

JOBS_POLL_MS=1000
SCHEDULER_ENABLED=true

# Quy tắc nghiệp vụ còn [..] trong BA – giá trị đề xuất, chủ dự án chốt sau
APPROVAL_DUE_DAYS=3
APPROVAL_REMIND_MIN_HOURS=24
REVIEW_PERIOD_MONTHS=12
MINOR_UNLOCK_DAYS=3
BACKDATE_MAX_WORKING_DAYS=3
SHARE_MAX_DAYS=30
SHARE_REMIND_DAYS=3
DELEGATION_MAX_AMOUNT=500000000
ACCOUNTING_DEPT_CODES=TCKT,LT
HR_DEPT_CODES=HCNS
INTERNAL_OPS_BLOCK_CODE=VHNB
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SEARCH_PER_MINUTE=60
# Chọn google (tương thích cũ) hoặc oidc. OIDC production bắt buộc HTTPS.
AUTH_MODE=google
# OIDC_ISSUER=https://id.example.com/application/o/vcworkspace
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_COMPANY_DOMAIN=vcworkspace.test
# OIDC_GROUP_ROLE_MAP_JSON={"vcw-admin":["R9"],"vcw-manager":["R4"]}
# OIDC_PROJECTION_MAX_AGE_SECONDS=300

# Coordinator lifecycle/revoke chat12B: fake | local | disabled. `local` chỉ chấp nhận loopback/localtest.me.
# Production mặc định disabled (route trả 503) và chặn fake khi khởi động.
IDENTITY_LIFECYCLE_MODE=fake
# IDENTITY_AUTHENTIK_BASE_URL=http://authentik.localtest.me:18121/api/v3
# IDENTITY_AUTHENTIK_TOKEN=
# IDENTITY_NEXTCLOUD_BASE_URL=http://nextcloud.localtest.me:18120/ocs/v1.php/cloud
# IDENTITY_NEXTCLOUD_ADMIN_USER=admin12
# IDENTITY_NEXTCLOUD_ADMIN_PASSWORD=
# IDENTITY_NEXTCLOUD_CONTROL_URL=http://127.0.0.1:18127
# IDENTITY_NEXTCLOUD_CONTROL_TOKEN=
# IDENTITY_LIFECYCLE_TIMEOUT_MS=5000

# Flow chat14: receiver webhook Nextcloud webhook_listeners (mặc định tắt, route trả 503).
# Header X-VCW-Flow-Token: phần tử đầu là bí mật hiện hành; thêm bản cũ (dấu phẩy) trong lúc xoay vòng.
# Runner là app password của chính người chạy flow (không dùng admin). Non-production chỉ http loopback/localtest.me.
FLOW_ENABLED=false
# FLOW_COMPANY_ID=
# FLOW_WEBHOOK_SECRETS=
# FLOW_NEXTCLOUD_BASE_URL=http://nc13.localtest.me:18130
# FLOW_NEXTCLOUD_CREDENTIALS_JSON={"runner":{"username":"<uid Nextcloud>","password":"<app password>"}}
# FLOW_NEXTCLOUD_USER_BINDINGS_JSON={"<uid Nextcloud>":"nguoi.nhan@vcprosperous.com"}
# FLOW_RULES_JSON=[{"id":"form-deck","kind":"forms.submission-to-deck","runner":"runner","formId":5,"boardId":8,"stackId":24}]
# FLOW_WORKER_POLL_MS=500
# FLOW_LEASE_MS=60000
# FLOW_MAX_ATTEMPTS=5
# FLOW_RETRY_BASE_MS=2000
# FLOW_RECONCILE_MS=0
