# Biến môi trường cho api ở production – chép thành deploy/api.env trên máy chủ. KHÔNG commit.
# MONGODB_URI, VAULT_DIR, UPLOAD_TMP_DIR, NODE_ENV do docker-compose.prod.yml đặt.
PORT=4000
PUBLIC_API_ORIGIN=https://vcdocs.vcprosperous.com
WEB_ORIGIN=https://vcdocs.vcprosperous.com
ALLOWED_DOMAIN=vcprosperous.com
COOKIE_SECURE=true
SESSION_HOURS=8

GOOGLE_MODE=real
SEED_DEMO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Đường dẫn trong container (thư mục deploy/secrets/ được gắn vào /run/secrets, chỉ đọc)
GOOGLE_SA_WRITE_KEY=/run/secrets/vcdocs-sa.json
GOOGLE_SA_READ_KEY=/run/secrets/vcdocs-sa.json
GOOGLE_ADMIN_SUBJECT=
MAIL_FROM=vcdocs@vcprosperous.com

JOBS_POLL_MS=1000
SCHEDULER_ENABLED=true

# Quy tắc nghiệp vụ – giữ như apps/api/.env.example cho tới khi chủ dự án chốt
APPROVAL_DUE_DAYS=3
APPROVAL_REMIND_MIN_HOURS=24
REVIEW_PERIOD_MONTHS=12
MINOR_UNLOCK_DAYS=3
BACKDATE_MAX_WORKING_DAYS=3
SHARE_MAX_DAYS=30
SHARE_REMIND_DAYS=3
DELEGATION_MAX_AMOUNT=500000000
ACCOUNTING_DEPT_CODES=TCKT,LT
HR_DEPT_CODES=HCNS
INTERNAL_OPS_BLOCK_CODE=VHNB
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SEARCH_PER_MINUTE=60

# ── Phân hệ VCworkspace ──────────────────────────────────────────────────────────────────────
# Production hiện chỉ chạy nghiệp vụ VCdocs + Google thật (phương án A,
# docs/ke-hoach/vcworkspace-20-production-phuong-an.md). Các phân hệ dưới đây để TẮT tường minh.
# Ở production: không đặt thì API tự tắt (disabled); đặt giá trị `fake` thì API dừng khi khởi động.
# Phía web phải build khớp: NEXT_PUBLIC_WORKSPACE_MODULES (xem deploy/.env.example).

# Đăng nhập: google (hiện tại) | oidc (Authentik – chỉ khi đã dựng IdP thật, bắt buộc HTTPS).
AUTH_MODE=google
# OIDC_ISSUER=https://id.vcprosperous.com/application/o/vcworkspace
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                (bí mật – chỉ điền trên máy chủ)
# OIDC_COMPANY_DOMAIN=vcprosperous.com
# OIDC_GROUP_ROLE_MAP_JSON={"vcw-admin":["R9"]}
# OIDC_PROJECTION_MAX_AGE_SECONDS=300

# Identity lifecycle (app→Authentik→Nextcloud). Production chưa có cổng thật: để disabled,
# route /identity/lifecycle-operations trả 503. Chế độ local chỉ gọi endpoint thử trên máy dev.
IDENTITY_LIFECYCLE_MODE=disabled

# Bộ nhớ VCworkspace (Drive/Văn bản/Bảng tính/Trình chiếu): disabled | nextcloud.
# disabled: /spaces, /drive/*, liên thông mail↔drive trả 503 STORAGE_UNAVAILABLE.
WORKSPACE_STORAGE_MODE=disabled
# Khi bật nextcloud (credentials là app password theo từng người, bí mật). Adapter hiện chỉ nhận
# Nextcloud loopback (PoC) – chưa dùng được trên production:
# WORKSPACE_STORAGE_BASE_URL=https://cloud.vcprosperous.com
# WORKSPACE_STORAGE_CREDENTIALS_JSON={"nguoi@vcprosperous.com":{"username":"<uid>","password":"<app password>"}}
# WORKSPACE_STORAGE_TIMEOUT_MS=15000

# Trình soạn thảo ONLYOFFICE: cần WORKSPACE_STORAGE_MODE khác disabled, nếu không API dừng khi khởi động.
DOCUMENT_EDITOR_ENABLED=false
# DOCUMENT_EDITOR_PUBLIC_ORIGIN=https://office.vcprosperous.com      (khớp NEXT_PUBLIC_DOCUMENT_SERVER_ORIGINS của web)
# DOCUMENT_EDITOR_INTERNAL_ORIGIN=http://onlyoffice                  (địa chỉ API gọi Document Server trong mạng nội bộ)
# DOCUMENT_EDITOR_API_ORIGIN=http://api:4000                          (địa chỉ Document Server gọi ngược về API)
# DOCUMENT_EDITOR_JWT_SECRET=        (bí mật riêng, tối thiểu 32 byte: openssl rand -hex 32)

# Email VCworkspace: disabled | stalwart. disabled: /mail/* trả 503; MAIL_FROM ở trên (thông báo
# qua Gmail của Google) không bị ảnh hưởng.
# Lưu ý: mã hiện tại chỉ cho Stalwart ở loopback (PoC chat07) – chưa dùng được trên production.
MAIL_ENGINE_MODE=disabled
# MAIL_ENGINE_HOST=127.0.0.1
# MAIL_ENGINE_SMTP_PORT=18465
# MAIL_ENGINE_IMAP_PORT=18993
# MAIL_ENGINE_SIEVE_PORT=14190
# MAIL_ENGINE_CONTROL_PORT=19090
# MAIL_ENGINE_CONTROL_TOKEN=         (bí mật)
# MAIL_ENGINE_CREDENTIALS_JSON={}
# MAIL_ENGINE_MANAGEMENT_URL=
# MAIL_ENGINE_MANAGEMENT_USER=
# MAIL_ENGINE_MANAGEMENT_PASSWORD=   (bí mật)

# Flow (webhook Nextcloud → Deck/Tables/tag): tắt, route trả 503. Bật cần Nextcloud HTTPS thật.
FLOW_ENABLED=false
# FLOW_COMPANY_ID=                   (ObjectId công ty)
# FLOW_WEBHOOK_SECRETS=              (bí mật 32–256 byte, phẩy ngăn cách khi xoay vòng)
# FLOW_NEXTCLOUD_BASE_URL=https://cloud.vcprosperous.com
# FLOW_NEXTCLOUD_CREDENTIALS_JSON={"runner":{"username":"<uid>","password":"<app password>"}}
# FLOW_NEXTCLOUD_USER_BINDINGS_JSON={"<uid>":"nguoi.nhan@vcprosperous.com"}
# FLOW_RULES_JSON=[]
# FLOW_WORKER_POLL_MS=500
# FLOW_LEASE_MS=60000
# FLOW_MAX_ATTEMPTS=5
# FLOW_RETRY_BASE_MS=2000
# FLOW_RECONCILE_MS=0
