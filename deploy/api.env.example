# Biến môi trường cho api ở production – chép thành deploy/api.env trên máy chủ. KHÔNG commit.
# MONGODB_URI, VAULT_DIR, UPLOAD_TMP_DIR, NODE_ENV do docker-compose.prod.yml đặt.
PORT=4000
PUBLIC_API_ORIGIN=https://vcdocs.vcprosperous.com
WEB_ORIGIN=https://vcdocs.vcprosperous.com
ALLOWED_DOMAIN=vcprosperous.com
COOKIE_SECURE=true
SESSION_HOURS=8

GOOGLE_MODE=real
SEED_DEMO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Đường dẫn trong container (thư mục deploy/secrets/ được gắn vào /run/secrets, chỉ đọc)
GOOGLE_SA_WRITE_KEY=/run/secrets/vcdocs-sa.json
GOOGLE_SA_READ_KEY=/run/secrets/vcdocs-sa.json
GOOGLE_ADMIN_SUBJECT=
MAIL_FROM=vcdocs@vcprosperous.com

# Identity lifecycle (app→Authentik→Nextcloud). Production chưa có cổng thật: để disabled (mặc định),
# route /identity/lifecycle-operations trả 503. Giá trị fake bị chặn khi khởi động ở production.
IDENTITY_LIFECYCLE_MODE=disabled

JOBS_POLL_MS=1000
SCHEDULER_ENABLED=true

# Quy tắc nghiệp vụ – giữ như apps/api/.env.example cho tới khi chủ dự án chốt
APPROVAL_DUE_DAYS=3
APPROVAL_REMIND_MIN_HOURS=24
REVIEW_PERIOD_MONTHS=12
MINOR_UNLOCK_DAYS=3
BACKDATE_MAX_WORKING_DAYS=3
SHARE_MAX_DAYS=30
SHARE_REMIND_DAYS=3
DELEGATION_MAX_AMOUNT=500000000
ACCOUNTING_DEPT_CODES=TCKT,LT
HR_DEPT_CODES=HCNS
INTERNAL_OPS_BLOCK_CODE=VHNB
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SEARCH_PER_MINUTE=60
