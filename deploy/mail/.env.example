# Biến cho deploy/mail/docker-compose.yml – chép thành deploy/mail/.env trên máy chủ thư. KHÔNG commit file .env.

# Tên máy chủ thư (không phải tên miền thư). Bản ghi A của tên này phải trỏ về IP tĩnh của máy chủ.
MAIL_HOSTNAME=mail.vcparts.vn

# Bản Stalwart, ghim theo digest: 0.16.27 (bản đã thử; digest này có cả amd64 và arm64).
# Đổi bản là việc có chủ ý: xem deploy/mail/README.md mục 13.
STALWART_IMAGE=stalwartlabs/stalwart@sha256:c429b311c93db5606598abc1c68225a85a6953183848ae01bee9c6a98885836c

# Sao lưu (backup.sh, khoi-phuc.sh): thư mục trên đĩa máy chủ và số bộ giữ lại tại chỗ.
BACKUP_DIR=/var/backups/vcmail
BACKUP_KEEP=7
# Để trống = chỉ sao lưu tại chỗ. Có giá trị (s3://ten-bucket/duong-dan) thì backup.sh đẩy thêm lên S3 bằng lệnh aws.
BACKUP_S3=

# Chỉ khi gửi thư ra qua trạm chuyển tiếp (Amazon SES…): mật khẩu SMTP của trạm. Để trống nếu gửi thẳng cổng 25.
SMARTHOST_PASSWORD=
