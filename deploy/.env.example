# Biến cho docker-compose.prod.yml – chép thành deploy/.env trên máy chủ. KHÔNG commit file .env.
DOMAIN=vcdocs.vcprosperous.com
# Thư mục trên đĩa dữ liệu riêng (đĩa bền, có snapshot): mongo/, vault/, uploads/, caddy/, backup/
DATA_DIR=/mnt/vcdocs-data
MONGO_USER=vcdocs
# Sinh bằng: openssl rand -hex 24
MONGO_PASSWORD=
# Bucket Cloud Storage cho deploy/backup.sh
BACKUP_BUCKET_DB=gs://vcdocs-sao-luu-csdl
BACKUP_BUCKET_VAULT=gs://vcdocs-sao-luu-kho-pdf
