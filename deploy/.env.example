# Biến cho docker-compose.prod.yml – chép thành deploy/.env trên máy chủ. KHÔNG commit file .env.
DOMAIN=vcdocs.vcprosperous.com
# Thư mục trên đĩa dữ liệu riêng (đĩa bền, có snapshot): mongo/, vault/, uploads/, caddy/, backup/
DATA_DIR=/mnt/vcdocs-data
MONGO_USER=vcdocs
# Sinh bằng: openssl rand -hex 24
MONGO_PASSWORD=
# Bucket Cloud Storage cho deploy/backup.sh
BACKUP_BUCKET_DB=gs://vcdocs-sao-luu-csdl
BACKUP_BUCKET_VAULT=gs://vcdocs-sao-luu-kho-pdf

# Phân hệ VCworkspace hiện trên giao diện – nhúng lúc build web (docker compose ... --build).
# Danh sách phẩy ngăn cách: drive, mail. Để trống = ẩn hết (production phương án A).
# Phải khớp WORKSPACE_STORAGE_MODE / MAIL_ENGINE_MODE trong api.env.
WORKSPACE_MODULES=
# Origin ONLYOFFICE Document Server (khớp DOCUMENT_EDITOR_PUBLIC_ORIGIN). Để trống = không nạp editor.
DOCUMENT_SERVER_ORIGINS=
# google | oidc – nút đăng nhập ở trang /dang-nhap, khớp AUTH_MODE trong api.env.
AUTH_PROVIDER=google
